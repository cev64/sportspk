<?xml version="1.0" encoding="utf-8"?>
<!--
  Android auto-backup (API 30-es). The Room cache of scoreboards is disposable and
  intentionally excluded; favorites and preferences are the data worth restoring.
  This is a convenience layer only - see Settings > Data for the explicit JSON export.
-->
<full-backup-content>
    <include domain="database" path="sportspk.db" />
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
</full-backup-content>
